rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // A business must exist in the database and be owned by the authenticated caller.
    // Missing business documents or businesses owned by other users explicitly return false.
    function isBusinessOwner(bizId) {
      return bizId is string &&
             exists(/databases/$(database)/documents/businesses/$(bizId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             data.role is string && (data.role == 'CUSTOMER' || data.role == 'BUSINESS_OWNER' || data.role == 'ADMIN') &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 250000)) &&
             (!('aiPreferredName' in data) || (data.aiPreferredName is string && data.aiPreferredName.size() <= 100)) &&
             (!('hasAcceptedTerms' in data) || data.hasAcceptedTerms is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidBusiness(data) {
      return data.ownerId is string && data.ownerId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.categorySlug is string && data.categorySlug.size() <= 100 &&
             data.city is string && data.city.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 50 &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100)) &&
             (!('descriptionSw' in data) || (data.descriptionSw is string && data.descriptionSw.size() <= 2000)) &&
             (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 2000)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('rating' in data) || data.rating is number) &&
             (!('reviewCount' in data) || data.reviewCount is int) &&
             (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 200)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidListing(data) {
      return data.businessId is string && data.businessId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.businessName is string && data.businessName.size() <= 150 &&
             data.titleSw is string && data.titleSw.size() >= 1 && data.titleSw.size() <= 200 &&
             (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 200)) &&
             (!('descriptionSw' in data) || (data.descriptionSw is string && data.descriptionSw.size() <= 2000)) &&
             (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 2000)) &&
             data.priceTzs is int && data.priceTzs >= 0 &&
             data.categorySlug is string && data.categorySlug.size() <= 100 &&
             data.type is string && (data.type == 'PRODUCT' || data.type == 'SERVICE') &&
             (!('status' in data) || (data.status is string && data.status in ['PENDING_REVIEW', 'PUBLISHED', 'REJECTED', 'ARCHIVED'])) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 250000)) &&
             (!('viewsCount' in data) || data.viewsCount is int) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Self registration: user can only register as CUSTOMER or BUSINESS_OWNER, never ADMIN
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    incoming().userId == request.auth.uid &&
                    incoming().role in ['CUSTOMER', 'BUSINESS_OWNER'] &&
                    isValidUser(incoming());
      // Profile updates: user cannot escalate role to ADMIN
      allow update: if isSignedIn() &&
                    (
                      (request.auth.uid == userId &&
                       resource != null &&
                       incoming().userId == existing().userId &&
                       // Non-admin callers can only stay CUSTOMER/BUSINESS_OWNER or preserve their existing role
                       (incoming().role in ['CUSTOMER', 'BUSINESS_OWNER'] || incoming().role == existing().role) &&
                       isValidUser(incoming())) ||
                      isAdmin()
                    );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                    incoming().ownerId == request.auth.uid &&
                    (!('isVerified' in incoming()) || incoming().isVerified == false) &&
                    (!('rating' in incoming()) || incoming().rating == 0 || incoming().rating == 0.0 || incoming().rating == 5 || incoming().rating == 5.0) &&
                    (!('reviewCount' in incoming()) || incoming().reviewCount == 0) &&
                    isValidBusiness(incoming());
      allow update: if isSignedIn() &&
                    resource != null &&
                    (
                      (resource.data.ownerId == request.auth.uid &&
                       incoming().ownerId == resource.data.ownerId &&
                       // Owner cannot verify their own business or fabricate ratings
                       incoming().isVerified == resource.data.isVerified &&
                       (!('rating' in incoming()) || incoming().rating == resource.data.rating) &&
                       (!('reviewCount' in incoming()) || incoming().reviewCount == resource.data.reviewCount) &&
                       isValidBusiness(incoming())) ||
                      isAdmin()
                    );
      allow delete: if isSignedIn() &&
                    resource != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Listings collection
    match /listings/{listingId} {
      allow get, list: if true;
      // Creation: must be linked to an EXISTING business owned by the authenticated caller
      allow create: if isSignedIn() &&
                    incoming().ownerId == request.auth.uid &&
                    (!('isFeatured' in incoming()) || incoming().isFeatured == false) &&
                    (!('viewsCount' in incoming()) || incoming().viewsCount == 0) &&
                    isBusinessOwner(incoming().businessId) &&
                    (!('status' in incoming()) || incoming().status in ['PENDING_REVIEW', 'PUBLISHED']) &&
                    isValidListing(incoming());
      // Updates:
      // 1. Admin can perform any moderation, verification, or featuring
      // 2. Owner can update descriptive fields but CANNOT self-feature, tamper with views, or bypass review
      // 3. Public viewers can only increment viewsCount atomically
      allow update: if isSignedIn() && resource != null && (
        isAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          incoming().ownerId == resource.data.ownerId &&
          incoming().businessId == resource.data.businessId &&
          (!('isFeatured' in resource.data) || incoming().isFeatured == resource.data.isFeatured) &&
          incoming().viewsCount == resource.data.viewsCount &&
          // Status moderation rules:
          // A rejected listing can only transition to PENDING_REVIEW (re-submit for review), not directly to PUBLISHED
          (
            incoming().status == resource.data.status ||
            (resource.data.status == 'REJECTED' && incoming().status == 'PENDING_REVIEW') ||
            (resource.data.status == 'PUBLISHED' && incoming().status == 'ARCHIVED') ||
            (resource.data.status == 'ARCHIVED' && incoming().status == 'PENDING_REVIEW')
          ) &&
          isValidListing(incoming())
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
          incoming().viewsCount == resource.data.viewsCount + 1
        )
      );
      allow delete: if isSignedIn() &&
                    resource != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin());

      match /viewers/{viewerId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == viewerId;
      }
    }

    // -------------------------------------------------------------
    // SOKOTZ VIDEO ADS FEED & DYNAMIC PRICING COLLECTIONS
    // -------------------------------------------------------------

    // Advertising Packages: Publicly readable, admin-only managed & priced
    match /ad_packages/{packageId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Package Price Audit History: Admin-only audit log
    match /package_price_audits/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // immutable audit logs
    }

    // Ad Campaigns: Strict video advertising lifecycle
    match /ad_campaigns/{campaignId} {
      // Public feed: only ACTIVE, verified PAID campaigns can be viewed by buyers
      // Sellers can view their own campaigns; Admins can view all
      allow get, list: if (resource.data.status == 'ACTIVE' && resource.data.paymentStatus == 'PAID') ||
                          (isSignedIn() && resource.data.sellerId == request.auth.uid) ||
                          isAdmin();

      // Sellers can create campaigns for their own listings.
      // Initial paymentStatus can NEVER be 'PAID'. Counters must be 0.
      allow create: if isSignedIn() &&
                    incoming().sellerId == request.auth.uid &&
                    isBusinessOwner(incoming().businessId) &&
                    incoming().paymentStatus in ['UNPAID', 'PENDING_VERIFICATION'] &&
                    incoming().status in ['DRAFT', 'AWAITING_PAYMENT', 'AWAITING_REVIEW'] &&
                    (!('moderatedByAdminId' in incoming()) || incoming().moderatedByAdminId == null) &&
                    (!('impressionsCount' in incoming()) || incoming().impressionsCount == 0) &&
                    (!('clicksCount' in incoming()) || incoming().clicksCount == 0) &&
                    (!('likesCount' in incoming()) || incoming().likesCount == 0) &&
                    (!('commentsCount' in incoming()) || incoming().commentsCount == 0) &&
                    (!('sharesCount' in incoming()) || incoming().sharesCount == 0) &&
                    (!('savesCount' in incoming()) || incoming().savesCount == 0);

      // Updates:
      // 1. Admin can approve (mark PAID/ACTIVE), reject, suspend, resume, or edit any campaign
      // 2. Seller can update draft, submit for review, request reinstatement, or permanently close campaign
      //    (Seller CANNOT change paymentStatus to PAID or modify public engagement counters)
      // 3. Public engagement metrics: ONLY counter keys can be touched, sensitive fields must remain identical
      allow update: if isSignedIn() && resource != null && (
        isAdmin() ||
        (
          resource.data.sellerId == request.auth.uid &&
          incoming().sellerId == resource.data.sellerId &&
          incoming().businessId == resource.data.businessId &&
          incoming().listingId == resource.data.listingId &&
          incoming().packageId == resource.data.packageId &&
          incoming().packagePriceTzs == resource.data.packagePriceTzs &&
          // Seller CANNOT change paymentStatus to PAID
          (incoming().paymentStatus == resource.data.paymentStatus || (resource.data.paymentStatus == 'UNPAID' && incoming().paymentStatus == 'PENDING_VERIFICATION')) &&
          // Counters must not be forged by seller update
          incoming().impressionsCount == resource.data.impressionsCount &&
          incoming().clicksCount == resource.data.clicksCount &&
          incoming().likesCount == resource.data.likesCount &&
          incoming().commentsCount == resource.data.commentsCount &&
          incoming().sharesCount == resource.data.sharesCount &&
          incoming().savesCount == resource.data.savesCount &&
          (
            // Voluntary permanent closure
            (resource.data.status != 'PERMANENTLY_CLOSED' && incoming().status == 'PERMANENTLY_CLOSED') ||
            // Seller requesting reinstatement when product is available again
            (resource.data.status == 'PAUSED_PRODUCT_UNAVAILABLE' && incoming().reinstatementRequested == true) ||
            // Draft edits or submitting for review
            (resource.data.status in ['DRAFT', 'AWAITING_PAYMENT'] && incoming().status in ['DRAFT', 'AWAITING_PAYMENT', 'AWAITING_REVIEW'])
          )
        ) ||
        (
          // Public engagement metrics: strictly ONLY counter keys and updatedAt
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressionsCount', 'uniqueViewsCount', 'clicksCount', 'likesCount', 'commentsCount', 'sharesCount', 'savesCount', 'updatedAt']) &&
          // Immutable core business fields
          incoming().sellerId == resource.data.sellerId &&
          incoming().businessId == resource.data.businessId &&
          incoming().listingId == resource.data.listingId &&
          incoming().packageId == resource.data.packageId &&
          incoming().packagePriceTzs == resource.data.packagePriceTzs &&
          incoming().paymentStatus == resource.data.paymentStatus &&
          incoming().status == resource.data.status &&
          // Increments must be non-negative
          incoming().impressionsCount >= resource.data.impressionsCount &&
          incoming().clicksCount >= resource.data.clicksCount &&
          incoming().sharesCount >= resource.data.sharesCount &&
          incoming().savesCount >= resource.data.savesCount
        )
      );

      allow delete: if isSignedIn() && resource != null && (
        isAdmin() || (resource.data.sellerId == request.auth.uid && resource.data.status in ['DRAFT', 'AWAITING_PAYMENT'])
      );

      // Subcollection: Likes (Strict 1 like per user per campaign)
      match /likes/{userId} {
        allow get, list: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Subcollection: Comments (Buyer comments & Seller replies)
      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.auth.uid == incoming().userId;
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      }

      // Subcollection: Unique Viewers
      match /unique_viewers/{viewerId} {
        allow get, list: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == viewerId;
      }
    }

    // Ad Reports: Any authenticated user can submit a report; Admins manage review
    match /ad_reports/{reportId} {
      allow create: if isSignedIn() && request.auth.uid == incoming().reporterUserId;
      allow get, list, update, delete: if isAdmin();
    }

    // In-App Notifications: Recipient-only access; creation restricted to Admins and validated user actions
    match /ad_notifications/{notificationId} {
      allow get, list: if isSignedIn() && request.auth.uid == resource.data.recipientUserId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.recipientUserId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if isAdmin() ||
                    (
                      isSignedIn() &&
                      incoming().recipientUserId is string &&
                      (
                        (incoming().recipientUserId != request.auth.uid &&
                         incoming().type in ['COMMENT_RECEIVED', 'AD_REPORTED', 'REPLY_RECEIVED']) ||
                        (incoming().recipientUserId == request.auth.uid &&
                         incoming().type in ['PAYMENT_SUBMITTED', 'REINSTATEMENT_REQUESTED', 'PRODUCT_PAUSED'])
                      )
                    );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.recipientUserId || isAdmin());
    }

    // Saved Ads: Buyer personal list
    match /saved_ads/{userId}/items/{campaignId} {
      allow get, list, create, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Hidden Ads: Buyer personal preferences
    match /hidden_ads/{userId}/items/{campaignId} {
      allow get, list, create, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Payment Transactions: Idempotent and auditable financial records
    match /payment_transactions/{txnId} {
      allow get, list: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      // Seller can record payment submission, but CANNOT mark it VERIFIED
      allow create: if isSignedIn() &&
                    request.auth.uid == incoming().sellerId &&
                    incoming().status in ['PENDING', 'SUBMITTED'];
      // Verification is strictly reserved for authorized administrators
      allow update: if isAdmin();
      allow delete: if false; // immutable financial transaction ledger
    }
  }
}
