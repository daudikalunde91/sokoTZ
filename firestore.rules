rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBusinessOwner(bizId) {
      return exists(/databases/$(database)/documents/businesses/$(bizId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             data.role is string && (data.role == 'CUSTOMER' || data.role == 'BUSINESS_OWNER' || data.role == 'ADMIN') &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 250000)) &&
             (!('aiPreferredName' in data) || (data.aiPreferredName is string && data.aiPreferredName.size() <= 100)) &&
             (!('hasAcceptedTerms' in data) || data.hasAcceptedTerms is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidBusiness(data) {
      return data.ownerId is string && data.ownerId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.categorySlug is string && data.categorySlug.size() <= 100 &&
             data.city is string && data.city.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 50 &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100)) &&
             (!('descriptionSw' in data) || (data.descriptionSw is string && data.descriptionSw.size() <= 2000)) &&
             (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 2000)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('rating' in data) || data.rating is number) &&
             (!('reviewCount' in data) || data.reviewCount is int) &&
             (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 200)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidListing(data) {
      return data.businessId is string && data.businessId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.businessName is string && data.businessName.size() <= 150 &&
             data.titleSw is string && data.titleSw.size() >= 1 && data.titleSw.size() <= 200 &&
             (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 200)) &&
             (!('descriptionSw' in data) || (data.descriptionSw is string && data.descriptionSw.size() <= 2000)) &&
             (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 2000)) &&
             data.priceTzs is int && data.priceTzs >= 0 &&
             data.categorySlug is string && data.categorySlug.size() <= 100 &&
             data.type is string && (data.type == 'PRODUCT' || data.type == 'SERVICE') &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 250000)) &&
             (!('viewsCount' in data) || data.viewsCount is int) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: users can only manage their own profile and cannot self-assign or escalate to ADMIN
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    incoming().userId == request.auth.uid &&
                    incoming().role != 'ADMIN' &&
                    isValidUser(incoming());
      allow update: if isSignedIn() &&
                    request.auth.uid == userId &&
                    resource != null &&
                    incoming().userId == existing().userId &&
                    incoming().role == existing().role &&
                    isValidUser(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Businesses collection: public discovery, owner-protected writes, no self-verification or fabricated ratings
    match /businesses/{businessId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                    incoming().ownerId == request.auth.uid &&
                    (!('isVerified' in incoming()) || incoming().isVerified == false) &&
                    (!('rating' in incoming()) || incoming().rating == 0 || incoming().rating == 0.0) &&
                    (!('reviewCount' in incoming()) || incoming().reviewCount == 0) &&
                    isValidBusiness(incoming());
      allow update: if isSignedIn() &&
                    resource != null &&
                    resource.data.ownerId == request.auth.uid &&
                    incoming().ownerId == resource.data.ownerId &&
                    incoming().isVerified == resource.data.isVerified &&
                    (!('rating' in incoming()) || incoming().rating == resource.data.rating) &&
                    (!('reviewCount' in incoming()) || incoming().reviewCount == resource.data.reviewCount) &&
                    isValidBusiness(incoming());
      allow delete: if isSignedIn() &&
                    resource != null &&
                    resource.data.ownerId == request.auth.uid;
    }

    // Listings collection: public discovery, owner-protected writes, must link to own business, no self-featured placement
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                    incoming().ownerId == request.auth.uid &&
                    (!('isFeatured' in incoming()) || incoming().isFeatured == false) &&
                    (!('viewsCount' in incoming()) || incoming().viewsCount == 0) &&
                    isBusinessOwner(incoming().businessId) &&
                    isValidListing(incoming());
      allow update: if isSignedIn() && resource != null && (
        (
          resource.data.ownerId == request.auth.uid &&
          incoming().ownerId == resource.data.ownerId &&
          incoming().businessId == resource.data.businessId &&
          incoming().isFeatured == resource.data.isFeatured &&
          isValidListing(incoming())
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
          incoming().viewsCount == resource.data.viewsCount + 1
        )
      );
      allow delete: if isSignedIn() &&
                    resource != null &&
                    resource.data.ownerId == request.auth.uid;

      // Unique viewers subcollection: anti-abuse view counting
      match /viewers/{viewerId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == viewerId;
      }
    }
  }
}
